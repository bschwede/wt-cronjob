"Mislukte aanmeldpogingen (logtype auth, berichtvoorvoegsel \"Login failed\")"

msgid "Successful logins (log type auth, message prefix \"Login: \")"
msgstr ""
"Succesvolle aanmeldingen (logtype auth, berichtvoorvoegsel \"Login: \")"

msgid "Logouts (log type auth, message prefix \"Logout: \")"
msgstr "Afmeldingen (logtype auth, berichtvoorvoegsel \"Logout: \")"

msgid ""
"Application errors (log type error - the message is the exception trace)"
