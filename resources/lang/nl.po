msgstr "Recordupdates (logtype edit, berichtvoorvoegsel \"Update: \")"

msgid "Record deletions (log type edit, message prefix \"Delete: \")"
msgstr "Verwijderde records (logtype edit, berichtvoorvoegsel \"Delete: \")"

