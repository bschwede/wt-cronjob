msgid "Disable route events"
msgstr ""

#: resources/views/admin.phtml:398
msgid "Enable route events"
msgstr ""

#: resources/views/admin.phtml:406
msgid "Event webhook (external trigger)"
msgstr ""

#: resources/views/admin.phtml:409
msgid ""
"External systems can queue an event by GETting the endpoint below. Each "
"queued event runs its matching event-triggered job(s) at the next tick. The "
"token is required (send it in the X-Cronjob-Token header) and the endpoint "
"is rate-limited."
msgstr ""

