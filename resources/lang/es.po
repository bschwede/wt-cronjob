#: src/CronjobModule.php:124 src/CronjobModule.php:332
msgid "Cron Job Scheduler"
msgstr "Programador de tareas Cron"

#: src/CronjobModule.php:128
msgid ""
"Schedule and monitor maintenance jobs: cron expressions, run history and "
"manual trigger."
msgstr ""
"Programa y supervisa trabajos de mantenimiento: expresiones cron, historial "
"de ejecuciones y activación manual."

#: src/CronjobModule.php:400
#, php-format
msgid "Job name must be a slug: %1$s, max %2$s characters."
msgstr "El nombre del trabajo debe ser un slug: %1$s, máximo %2$s caracteres."

#: src/CronjobModule.php:403
msgid "Job title must not be empty."
msgstr "El título del trabajo no debe estar vacío."

#: src/CronjobModule.php:412
#, php-format
msgid "Job title must be at most %d characters."
msgstr "El título del trabajo debe tener como máximo %d caracteres."

#: src/CronjobModule.php:415
#, php-format
msgid "Arguments must be at most %d characters."
msgstr "Los argumentos deben tener como máximo %d caracteres."

#: src/CronjobModule.php:420
#, php-format
msgid "Command must be a %1$s path or an allowlisted core command."
msgstr "El comando debe ser una ruta %1$s o un comando principal permitido."

#: src/CronjobModule.php:428
#, php-format
msgid "Invalid command: %s"
msgstr "Comando no válido: %s"

#: src/CronjobModule.php:443
msgid "A job with this name already exists."
msgstr "Ya existe un trabajo con este nombre."

#: src/CronjobModule.php:462
msgid "Job saved."
msgstr "Trabajo guardado."

#: src/CronjobModule.php:537 resources/views/job-history.phtml:36
msgid "Run History"
msgstr "Historial"

#: src/CronjobModule.php:567
msgid "Job queued - it will run at the next tick (within 60 seconds)."
msgstr ""
"Trabajo en cola: se ejecutará en el próximo ciclo (dentro de 60 segundos)."

#: src/CronjobModule.php:571
msgid ""
"Job queued - it is disabled, so it will run once at the next tick after it "
"is (re-)enabled."
msgstr ""
"Trabajo en cola: está deshabilitado, así que se ejecutará una vez en el "
"siguiente ciclo después de que se (re)habilite."

#: src/CronjobModule.php:574 src/CronjobModule.php:601
#: src/CronjobModule.php:626 src/CronjobModule.php:657
#: src/CronjobModule.php:698 resources/views/job-history.phtml:43
msgid "Job not found."
msgstr "Trabajo no encontrado."

#: src/CronjobModule.php:597
msgid "Job enabled."
msgstr "Trabajo habilitado."

#: src/CronjobModule.php:597
msgid "Job disabled."
msgstr "Trabajo deshabilitado."

#: src/CronjobModule.php:622
msgid "Failure notification enabled."
msgstr "Notificación de fallo activada."

#: src/CronjobModule.php:622
msgid "Failure notification disabled."
msgstr "Notificación de fallos desactivada."

#: src/CronjobModule.php:639
msgid "Route events disabled."
msgstr "Eventos de ruta desactivados."

#: src/CronjobModule.php:639
msgid "Route events enabled."
msgstr "Eventos de ruta habilitados."

#: src/CronjobModule.php:664
msgid ""
"This job is not (any longer) offered by a module - reset is not possible."
msgstr "El módulo ya no ofrece esta tarea; no se puede restablecer."

#: src/CronjobModule.php:682
msgid "Job reset to the module defaults."
msgstr "El trabajo se ha restablecido a los valores predeterminados del módulo."

#: src/CronjobModule.php:696
msgid "Job deleted."
msgstr "El trabajo se ha eliminado."

#: src/CronjobModule.php:710
msgid ""
"The watch daemon needs proc_open(), which is disabled on this server. Use an "
"OS cron or systemd timer instead."
msgstr ""
"El agente daemon needs proc_open(), which is disabled on this server. Use an "
"OS cron or systemd timer instead."

#: src/CronjobModule.php:717
msgid "Watch daemon started."
msgstr "Se ha iniciado el agente Watch."

#: src/CronjobModule.php:719
msgid ""
"The watch daemon could not be started (proc_open is disabled or it is "
"already running)."
msgstr ""
"No se pudo iniciar el daemon de vigilancia (proc_open está desactivado o ya "
"se está ejecutando)."

#: src/CronjobModule.php:731
msgid ""
"Watch daemon stopped - it exits within about a minute and will not restart."
msgstr ""
"No se pudo iniciar el agente daemon de vigilancia (proc_open está "
"deshabilitado o ya se está ejecutando). El agente daemon se cierra en "
"aproximadamente un minuto y no se reiniciará."

#: src/CronjobModule.php:749
#, php-format
msgid "The path may only contain letters, digits, spaces and the characters %s"
msgstr ""
"La ruta solo puede contener letras, números, espacios y los caracteres %s"

#: src/CronjobModule.php:757
msgid "PHP binary: automatic detection enabled."
msgstr "Binario de PHP: detección automática activada."

#: src/CronjobModule.php:758
#, php-format
msgid "PHP binary set to %s."
msgstr "Binario de PHP configurado en %s."

#: src/CronjobModule.php:829
msgid "Webhook token regenerated - update any external sender."
msgstr "Token de webhook regenerado: actualiza cualquier remitente externo."

#. I18N: default title of the pseudo-events job (job list in the cronjob admin)
#: cron-jobs.php:54
msgid "Cronjob: Pseudo-Events (log-table pollers)"
msgstr "Cronjob: Pseudo-eventos (sondeadores de tabla de registro)"

#. I18N: command description for pseudo-events.php (command catalog in the cronjob admin)
#: cron-jobs.php:70
msgid ""
"Poll the webtrees log table (failed logins, logins, logouts, errors, record "
"edits, searches) and queue one event per new matching log entry for the tick."
msgstr ""
"Consulta la tabla de registros de webtrees (ingresos fallidos, ingresos, "
"cierres de sesión, errores, ediciones de registros, búsquedas) y pon en cola "
"un evento por cada nueva entrada de registro que coincida para el tick."

#. I18N: parameter description for --force (command catalog in the cronjob admin)
#: cron-jobs.php:76
msgid "Bypass the 5-minute cooldown (a manual run)."
msgstr "Saltar la espera de 5 minutos (una ejecución manual)."

#. I18N: command description for smoke-job.php (command catalog in the cronjob admin)
#: cron-jobs.php:84
msgid "Acceptance-test job for the cronjob module. It only prints and exits 0."
msgstr ""
"Trabajo de prueba de aceptación para el módulo de cronjob. Solo imprime y "
"sale con 0."

#. I18N: parameter description for --sleep=N (command catalog in the cronjob admin)
#: cron-jobs.php:90
msgid "keeps the process alive for N seconds (timeout testing)"
msgstr ""
"mantiene el proceso activo durante N segundos (prueba de tiempo de espera)"

#: resources/views/admin.phtml:47
msgid ""
"The site is offline (data/offline.txt) - the tick is skipped and no jobs run "
"until it is removed again (e.g. during a webtrees update)."
msgstr ""
"El sitio está fuera de línea (data/offline.txt): se omite el tick y no se "
"ejecutan trabajos hasta que se elimine de nuevo (por ejemplo, durante una "
"actualización de webtrees)."

#: resources/views/admin.phtml:53
msgid ""
"Bundled cron library missing: fetch dragonmantank/cron-expression into "
"modules_v4/cronjob/vendor/ (see the module README, section \"Bundled "
"dependency\"). Scheduling is paused until then."
msgstr ""
"Falta la biblioteca cron incluida: consigue dragonmantank/cron-expression en "
"modules_v4/cronjob/vendor/ (mira el README del módulo, sección \"Dependencia "
"incluida\"). La programación está pausada hasta entonces."

#: resources/views/admin.phtml:58 resources/views/job-form.phtml:159
#, php-format
msgid "All times are UTC (webtrees server time). Current time (UTC): %s"
msgstr ""
"Todos los horarios son UTC (hora del servidor de webtrees). Hora actual (UTC)"
": %s"

#: resources/views/admin.phtml:63 resources/views/admin.phtml:263
msgid "Installation"
msgstr "Instalación"

#: resources/views/admin.phtml:63
#, php-format
msgid ""
"The tick does not appear to have run yet, so this module does not yet have "
"any functionality. Please refer to the information in the “%s” section."
msgstr ""
"Parece que el tick aún no se ha ejecutado, así que este módulo todavía no "
"tiene ninguna funcionalidad. Por favor, consulta la información en la "
"sección “%s”."

#: resources/views/admin.phtml:67
#, php-format
msgid "Time elapsed since the last tick execution: %s s"
msgstr "Tiempo transcurrido desde la última ejecución del tick: %s s"

#: resources/views/admin.phtml:74 resources/views/job-form.phtml:76
msgid "New Job"
msgstr "Nueva tarea"

#: resources/views/admin.phtml:79
msgid ""
"No jobs yet. Create the first one (e.g. the linkenhancer link-index update)."
msgstr ""
"Aún no hay trabajos. Crea el primero (por ejemplo, la actualización del "
"índice de enlaces de linkenhancer)."

#: resources/views/admin.phtml:91 resources/views/job-form.phtml:130
msgid "Triggers"
msgstr "Desencadenantes"

#: resources/views/admin.phtml:92
msgid "Next Run (UTC)"
msgstr "Próxima ejecución (UTC)"

#: resources/views/admin.phtml:93
msgid "Last Run"
msgstr "Última ejecución"

#: resources/views/admin.phtml:95
msgid "Notify"
msgstr "Notificar"

#: resources/views/admin.phtml:96
msgid "Timeout"
msgstr "Tiempo fuera"

#: resources/views/admin.phtml:120
#, php-format
msgid ""
"Seeded automatically from the %s manifest (cron-jobs.php / getCronJobs()). "
"The \"Reset\" button restores the module defaults."
msgstr ""
"Se configura automáticamente a partir del archivo de manifiesto %s (cron-"
"jobs.php / getCronJobs()). El botón «Restablecer» restablece los valores "
"predeterminados del módulo."

#: resources/views/admin.phtml:131
msgid ""
"This job has no usable trigger (pathological legacy row) - edit and save it "
"to set one."
msgstr ""
"Esta tarea no tiene ningún disparador válido (fila heredada anómala): "
"edítala y guárdala para configurar uno."

#: resources/views/admin.phtml:132
msgid "no trigger"
msgstr "sin disparador"

#: resources/views/admin.phtml:137 resources/views/job-history.phtml:48
msgid "event"
msgstr "evento"

#: resources/views/admin.phtml:141
msgid ""
"This event no longer exists (core update, mapping change or removed built-in "
"detector) - the job can never fire on it. Edit the job and pick a current "
"event."
msgstr ""
"Este evento ya no existe (actualización del núcleo, cambio en la asignación "
"o eliminación del detector integrado); por lo tanto, la tarea nunca se "
"activará con él. Edita la tarea y selecciona un evento actual."

#: resources/views/admin.phtml:142
msgid "unknown event"
msgstr "evento desconocido"

#: resources/views/admin.phtml:178
msgid "triggered by"
msgstr "provocado por"

#: resources/views/admin.phtml:182 resources/views/job-history.phtml:30
msgid "History"
msgstr "Historia"

#: resources/views/admin.phtml:190 resources/views/admin.phtml:200
#: resources/views/admin.phtml:407
msgid "on"
msgstr "abierto"

#: resources/views/admin.phtml:190 resources/views/admin.phtml:200
#: resources/views/admin.phtml:407
msgid "off"
msgstr "apagado"

#: resources/views/admin.phtml:200
#, php-format
msgid "notify on failure: %s"
msgstr "Notificar en caso de error: %s"

#: resources/views/admin.phtml:206
msgid "s"
msgstr "s"

#: resources/views/admin.phtml:213
msgid "Run at the next tick (within 60 seconds)"
msgstr "Ejecutar en el siguiente tick (en un plazo de 60 segundos)"

#: resources/views/admin.phtml:213
msgid ""
"The job is disabled - the queued run happens at the next tick after it is "
"(re-)enabled"
msgstr ""
"El trabajo está desactivado; la ejecución en cola se lleva a cabo en el "
"siguiente tick tras su (re)activación."

#: resources/views/admin.phtml:214
msgid "Run now"
msgstr "Ejecutar ahora"

#: resources/views/admin.phtml:219
msgid ""
"Open the form prefilled with a copy of this job (new -copy slug, starts "
"disabled)"
msgstr ""
"Abre el formularío ya rellenado con una copia de esta oferta de empleo "
"(nueva - «copia» de slug, desactivada inicialmente)"

#: resources/views/admin.phtml:220
msgid "Duplicate"
msgstr "Duplicado"

#: resources/views/admin.phtml:224
msgid ""
"Reset this job to the module defaults? Your changes (title, schedule, "
"command, arguments, enabled state) will be lost; the notification setting is "
"kept."
msgstr ""
"¿Quieres restablecer la configuración predeterminada del módulo para esta "
"tarea? Se perderán los cambios que hayas realizado (título, programación, "
"comando, argumentos y estado de activación); la configuración de "
"notificaciones se mantendrá."

#: resources/views/admin.phtml:228
msgid "Restore the settings currently offered by the module manifest"
msgstr ""
"Restablecer la configuración que ofrece actualmente el conjunto de módulos"

#: resources/views/admin.phtml:234
msgid "Delete this job and its run history?"
msgstr "¿Deseas eliminar este trabajo y su historial de ejecuciones?"

#: resources/views/admin.phtml:268
msgid "Use one of the following install options, not both."
msgstr "Utiliza una de las siguientes opciones de instalación, pero no ambas."

#: resources/views/admin.phtml:273
msgid "Watch daemon (no OS cron needed)"
msgstr "Controlador de vigilancia (no requiere el cron del sistema operativo)"

#: resources/views/admin.phtml:275
msgid ""
"Runs the tick from a resident process instead of an OS cron / systemd timer "
"- for hosts without cron. A watchdog restarts it automatically if it dies."
msgstr ""
"Ejecuta el tick desde un proceso residente en lugar de mediante un "
"temporizador cron o systemd del sistema operativo, para los servidores que "
"no dispongan de cron. Un watchdog lo reinicia automáticamente si se detiene."

#: resources/views/admin.phtml:279
msgid "running"
msgstr "en funcionamiento"

#: resources/views/admin.phtml:281
msgid "stopped"
msgstr "terminó"

#: resources/views/admin.phtml:284
#, php-format
msgid "Last activity (UTC): %s"
msgstr "Última actividad (UTC): %s"

#: resources/views/admin.phtml:287
#, php-format
msgid "PID: %d"
msgstr "PID: %d"

#: resources/views/admin.phtml:293
msgid "Stop watch"
msgstr "Para cronómetro"

#: resources/views/admin.phtml:298
msgid "Start watch"
msgstr "Poner en marcha el cronómetro"

#: resources/views/admin.phtml:305
msgid "Trigger Installation"
msgstr "Instalación del disparador"

#: resources/views/admin.phtml:307
msgid ""
"The module itself does not start. One OS trigger (a per-minute timer) or the "
"built-in watch daemon must call the tick once per minute. Pick the option "
"for your OS below - the paths are already filled in for this installation."
msgstr ""
"El módulo en sí no se inicia. Un disparador del sistema operativo (un "
"temporizador por minuto) o el agente de reloj integrado deben llamar a la "
"función «tick» una vez por minuto. Selecciona a continuación la opción "
"correspondiente a tu sistema operativo; las rutas ya están preconfiguradas "
"para esta instalación."

#: resources/views/admin.phtml:314
msgid "Option: Windows Task Scheduler (every minute)"
msgstr "Opción: Programador de tareas de Windows (cada minuto)"

#: resources/views/admin.phtml:317
msgid "Install command"
msgstr "Comando de instalación"

#: resources/views/admin.phtml:320
msgid ""
"Alternatively: the watch daemon (left fieldset) runs the tick with no OS "
"trigger at all. For a server that runs without a logged-in user, set the "
"task to \"run whether the user is logged on or not\" (task properties -> "
"General, requires a password)."
msgstr ""
"Otra opción: el agente de vigilancia (cuadro de la izquierda) ejecuta el "
"tick sin ningún tipo de activador del sistema operativo. En el caso de un "
"servidor que funcione sin ningún usuario conectado, configura la tarea para "
"que «se ejecute independientemente de si el usuario está conectado o no» "
"(propiedades de la tarea -> General; requiere contraseña)."

#: resources/views/admin.phtml:323
msgid "Option A: classic cron (every minute)"
msgstr "Opción A: cron clásico (cada minuto)"

#: resources/views/admin.phtml:328
msgid "Option B: systemd timer"
msgstr "Opción B: temporizador de systemd"

#: resources/views/admin.phtml:334
msgid "Install commands"
msgstr "Comandos de instalación"

#: resources/views/admin.phtml:344
msgid "PHP CLI binary"
msgstr "Archivo binario de PHP CLI"

#: resources/views/admin.phtml:346
msgid ""
"The CLI interpreter the module uses for its PHP scripts (watch daemon spawn "
"and the trigger install commands above). Leave the field empty for automatic "
"detection."
msgstr ""
"El intérprete CLI que utiliza el módulo para sus scripts de PHP (véanse los "
"comandos «daemon spawn» y «trigger install» anteriores). Deja el campo en "
"blanco para que se detecte automáticamente."

#: resources/views/admin.phtml:349
msgid "Currently used:"
msgstr "Actualmente en uso:"

#: resources/views/admin.phtml:350
msgid "(none found)"
msgstr "(no se ha encontrado nada)"

#: resources/views/admin.phtml:352
msgid "manual path"
msgstr "ruta manual"

#: resources/views/admin.phtml:352
msgid "auto-detected"
msgstr "detectado automáticamente"

#: resources/views/admin.phtml:357
#, php-format
msgid ""
"The manual path %s is not a usable PHP CLI binary (missing, not executable "
"or an fpm build) - automatic detection is used instead."
msgstr ""
"La ruta manual %s no es un binario de PHP CLI válido (no existe, no es "
"ejecutable o es una versión de FPM); en su lugar, se utiliza la detección "
"automática."

#: resources/views/admin.phtml:362
msgid ""
"No PHP CLI binary could be determined - the watch daemon cannot start and "
"the install commands above are incomplete. Set a manual path below."
msgstr ""
"No se ha podido identificar ningún binario de PHP CLI: el demonio de "
"supervisión no se puede iniciar y los comandos de instalación anteriores "
"están incompletos. Indica una ruta manualmente a continuación."

#: resources/views/admin.phtml:369
msgid "e.g. /usr/bin/php8.3 - empty = automatic detection"
msgstr "Por ejemplo: /usr/bin/php8.3 - vacío = detección automática"

#: resources/views/admin.phtml:373
msgid ""
"A watch daemon that is already running keeps using its current binary until "
"it is restarted."
msgstr ""
"Un agente de vigilancia que ya se está ejecutando sigue utilizando su "
"binario actual hasta que se reinicia."

#: resources/views/admin.phtml:391
msgid "Pseudo-Events (log-table polling)"
msgstr "Pseudoeventos (encuestas de tabla de registro)"

#: resources/views/admin.phtml:393
msgid ""
"webtrees has no event bus, so core actions are observed by polling. The "
"module reads new log-table entries (failed logins, logins, logouts, errors, "
"record edits, searches) at most every 5 minutes and queues one event per "
"entry; an event-triggered job then acts on it. The first run only records a "
"baseline and does not fire."
msgstr ""
"webtrees no dispone de un bus de eventos, por lo que las acciones "
"principales se supervisan mediante sondeo. El módulo lee las nuevas entradas "
"de la tabla de registro (inicios de sesión fallidos, inicios de sesión, "
"cierres de sesión, errores, modificaciones de registros y búsquedas) como "
"máximo cada 5 minutos y pone en cola un evento por cada entrada; a "
"continuación, una tarea activada por eventos actúa en consecuencia. En la "
"primera ejecución solo se registra un valor de referencia y no se activa "
"ninguna tarea."

#: resources/views/admin.phtml:394
msgid ""
"To activate, enable the \"cronjob:pseudo-events\" job in the table above. It "
"runs in the tick child process - isolated from any web request and bounded "
"by its timeout."
msgstr ""
"Para activarla, habilita la tarea «cronjob:pseudo-events» en la tabla "
"anterior. Se ejecuta en el proceso anterior de tick, aislada de cualquier "
"solicitud web y limitada por su tiempo de espera."

#: resources/views/admin.phtml:401
msgid "Route events (request-triggered)"
msgstr "Eventos de enrutamiento (activados por solicitud)"

#: resources/views/admin.phtml:403
msgid ""
"Detects mutations directly from their HTTP route (e.g. a note edit) and "
"queues a matching event immediately - in addition to the polling pseudo-"
"events above. Only curated routes fire, only while this is enabled AND a "
"matching event job is listening."
msgstr ""
"Detecta mutaciones directamente a partir de su ruta HTTP (por ejemplo, la "
"edición de una nota) y pone en cola un evento correspondiente de inmediato, "
"además de los pseudoeventos de sondeo mencionados anteriormente. Solo se "
"activan las rutas seleccionadas, siempre y cuando esta función esté "
"habilitada Y haya una tarea de eventos correspondiente a la espera."

#: resources/views/admin.phtml:412
msgid "Disable route events"
msgstr "Desactivar eventos de ruta"

#: resources/views/admin.phtml:412
msgid "Enable route events"
msgstr "Habilitar eventos de ruta"

#: resources/views/admin.phtml:420
msgid "Event webhook (external trigger)"
msgstr "Webhook de eventos (desencadenante externo)"

#: resources/views/admin.phtml:423
msgid ""
"External systems can queue an event by GETting the endpoint below. Each "
"queued event runs its matching event-triggered job(s) at the next tick. The "
"token is required (send it in the X-Cronjob-Token header) and the endpoint "
"is rate-limited."
msgstr ""
"Los sistemas externos pueden poner un evento en cola mediante una solicitud "
"GET al punto de conexión que se indica a continuación. Cada evento puesto en "
"cola ejecuta la(s) tarea(s) activada(s) por ese evento en el siguiente tick. "
"Es obligatorio incluir el token (enviándolo en el encabezado X-Cronjob-"
"Token) y el punto de conexión tiene un límite de frecuencia."

#: resources/views/admin.phtml:431
msgid "Endpoint"
msgstr "Punto final"

#: resources/views/admin.phtml:436
msgid ""
"GET with query params event=<name> and data=<json> (optional); send the "
"token in the X-Cronjob-Token header."
msgstr ""
"GET con los parámetros de consulta event=<nombre> y data=<json> (opcional); "
"envía el token en el encabezado X-Cronjob-Token."

#: resources/views/admin.phtml:441
msgid "Token"
msgstr "Token"

#: resources/views/admin.phtml:450
msgid "Regenerate token"
msgstr "Regenerar token"

#: resources/views/admin.phtml:460
msgid "Event catalog"
msgstr "Catálogo de eventos"

#: resources/views/admin.phtml:462
msgid ""
"All known event names: announced by modules, built-in pseudo-events "
"(cronjob:…), route events (_route:…) and names currently listened for by an "
"enabled job. Synced by the tick; use these names in the “Event name” field "
"of an event job."
msgstr ""
"Todos los nombres de eventos conocidos: los anunciados por los módulos, los "
"pseudoeventos integrados (cronjob:…), los eventos de ruta (_route:…) y los "
"nombres que está recibiendo actualmente una tarea activada. Se sincronizan "
"mediante el tick; utiliza estos nombres en el campo «Nombre del evento» de "
"una tarea de evento."

#: resources/views/admin.phtml:474
msgid "Payload"
msgstr "Carga útil"

#: resources/views/admin.phtml:495
msgid "Commands"
msgstr "Comandos"

#: resources/views/admin.phtml:503
msgid "Command catalog"
msgstr "Catálogo de comandos"

#: resources/views/admin.phtml:505
msgid ""
"Every command a job may run: the allowlisted core commands, commands "
"announced by modules (with their available parameters) and module CLI "
"scripts. A module that announces commands curates its own list, so its "
"internal scripts (e.g. cronjob tick/watch/wrap) are not offered. Use these "
"in the “Command” field of a job."
msgstr ""
"Todos los comandos que puede ejecutar una tarea: los comandos principales "
"incluidos en la lista de permitidos, los comandos anunciados por los módulos "
"(con sus parámetros disponibles) y los scripts de la interfaz de línea de "
"comandos (CLI) de los módulos. Un módulo que anuncia comandos gestiona su "
"propia lista, por lo que sus scripts internos (por ejemplo, tick/watch/wrap "
"de cronjob) no se ofrecen. Utilízalos en el campo «Comando» de una tarea."

#: resources/views/admin.phtml:514 resources/views/job-form.phtml:206
#: resources/views/job-form.phtml:209
msgid "Command"
msgstr "Comando"

#: resources/views/admin.phtml:518
msgid "Parameters"
msgstr "Parámetros"

#: resources/views/admin.phtml:536 resources/views/job-form.phtml:284
msgid "required"
msgstr "obligatorio"

#: resources/views/job-form.phtml:69
#, php-format
msgid "New Job (copy of %s)"
msgstr "Nuevo trabajo (copia de %s)"

#: resources/views/job-form.phtml:73
msgid "Edit Job"
msgstr "Editar tarea"

#: resources/views/job-form.phtml:94
msgid "Name (slug)"
msgstr "Nombre (slug)"

#: resources/views/job-form.phtml:101
msgid "This job is offered by a module, so its name is fixed."
msgstr "Este trabajo lo ofrece un módulo, por lo que su nombre es fijo."

#: resources/views/job-form.phtml:103
msgid "Used as identifier, not shown to users."
msgstr "Se utiliza como identificador; no se muestra a los usuarios."

#: resources/views/job-form.phtml:112
msgid "Update link index"
msgstr "Actualizar el índice de enlaces"

#: resources/views/job-form.phtml:124
msgid "Notify administrators on failure"
msgstr "Notificar a los administradores en caso de fallo"

#: resources/views/job-form.phtml:125
msgid ""
"On failure, message the site’s administrator accounts (e-mail and/or "
"internal message, per each admin’s own contact preference)."
msgstr ""
"En caso de fallo, envía un mensaje a las cuentas de los administradores del "
"sitio (por correo electrónico y/o mensaje interno, según las preferencias de "
"contacto de cada administrador)."

#: resources/views/job-form.phtml:132
msgid ""
"The job runs when any of its triggers fires: on one or more cron schedules "
"(UTC) and/or on one or more named events. At least one trigger is required."
msgstr ""
"La tarea se ejecuta cuando se activa cualquiera de sus desencadenantes: en "
"una o varias programaciones de cron (UTC) y/o en uno o varios eventos "
"específicos. Se requiere al menos un desencadenante."

#: resources/views/job-form.phtml:136
msgid "Time triggers (cron schedule)"
msgstr "Desencadenantes temporales (programación cron)"

#: resources/views/job-form.phtml:148
msgid "Next runs (UTC):"
msgstr "Próximas ejecuciones (UTC):"

#: resources/views/job-form.phtml:154
msgid "Invalid cron expression (5 fields, UTC)."
msgstr "Expresión cron no válida (5 campos, UTC)."

#: resources/views/job-form.phtml:160
msgid "Add cron trigger"
msgstr "Añadir una tarea programada"

#: resources/views/job-form.phtml:170
msgid "Event triggers"
msgstr "Desencadenantes de eventos"

#: resources/views/job-form.phtml:189
msgid ""
"The job runs once for each queued event with one of these names (webhook, "
"module push, built-in pseudo-event poller, or a route trigger)."
msgstr ""
"La tarea se ejecuta una vez por cada evento en cola que tenga uno de estos "
"nombres (webhook, envío de módulo, sondeo de pseudoeventos integrado o "
"activador de ruta)."

#: resources/views/job-form.phtml:190
msgid ""
"Suggested: module-announced events, built-in pseudo-events (cronjob:…) and "
"route events (_route:…). Plain slugs for your own events work too. The full "
"list is in the event catalog on the admin page."
msgstr ""
"Se recomienda utilizar: eventos anunciados por módulos, pseudoeventos "
"integrados (cronjob:…) y eventos de ruta (_route:…). También se pueden "
"utilizar slugs simples para tus propios eventos. La lista completa se "
"encuentra en el catálogo de eventos de la página de administración."

#: resources/views/job-form.phtml:191
msgid "Add event trigger"
msgstr "Añadir un desencadenante de evento"

#: resources/views/job-form.phtml:218
#, php-format
msgid "A %1s path or an allowlisted core command (%2$s)."
msgstr ""
"Una ruta %1s o un comando del núcleo incluido en la lista de permitidos "
"(%2$s)."

#: resources/views/job-form.phtml:223
msgid "Arguments (optional)"
msgstr "Argumentos (opcionales)"

#: resources/views/job-form.phtml:227
#, php-format
msgid "Plain options/values only, no shell metacharacters, max %1$s tokens."
msgstr ""
"Solo opciones/valores simples, sin metacaracteres de shell, máximo %1$s "
"tokens."

#: resources/views/job-form.phtml:231
#, php-format
msgid "Timeout (seconds, %1$s - %2$s)"
msgstr "Tiempo de espera (segundos, %1$s - %2$s)"

#: resources/views/job-form.phtml:237
#, php-format
msgid ""
"Note on sensitive output: %1$s writes the complete tree as %2$s into data/ "
"(full personal data!), %3$s lists all user e-mail addresses, %4$s lists all "
"site settings. This output is stored in the run history (admin-only)."
msgstr ""
"Nota sobre resultados confidenciales: %1$s guarda el árbol completo como "
"%2$s en la carpeta «data/» (¡datos personales completos!), %3$s muestra una "
"lista de todas las direcciones de correo electrónico de los usuarios y %4$s "
"muestra una lista de todos los ajustes del sitio. Estos resultados se "
"almacenan en el historial de ejecuciones (solo para administradores)."

#: resources/views/job-form.phtml:283
msgid "Available parameters"
msgstr "Parámetros disponibles"

#: resources/views/job-history.phtml:53
