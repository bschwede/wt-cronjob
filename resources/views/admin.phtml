<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Schwendinger\Webtrees\Module\Cronjob\Services\ScheduleService;

/**
 * @var string $title
 * @var \Schwendinger\Webtrees\Module\Cronjob\CronjobModule $module
 * @var array<int, object> $jobs
 * @var bool $offline
 * @var bool $cron_lib
 * @var string $cron_now
 * @var array<string, string> $install
 * @var array{enabled: bool, running: bool, last_tick: int} $watch
 * @var string $event_token
 * @var array<string, string> $offered
 * @var array<int, \Schwendinger\Webtrees\Module\Cronjob\Services\PseudoEvents\PseudoEventDetectorInterface> $detectors
 */

$admin_url = route('module', ['module' => $module->name(), 'action' => 'Admin']);

?>
<?= view('components/breadcrumbs', [
    'links' => [
        route(ControlPanel::class) => /*I18N: webtrees.pot */ I18N::translate('Control panel'),
        $admin_url => $module->title(),
    ]
]) ?>

<h1><?= e($title) ?></h1>

<?php if ($offline): ?>
    <div class="alert alert-warning">
        <?= I18N::translate('The site is offline (data/offline.txt) - the tick is skipped and no jobs run until it is removed again (e.g. during a webtrees update).') ?>
    </div>
<?php endif; ?>

<?php if (!$cron_lib): ?>
    <div class="alert alert-warning">
        <?= I18N::translate('Bundled cron library missing: fetch dragonmantank/cron-expression into modules_v4/cronjob/vendor/ (see the module README, section "Bundled dependency"). Scheduling is paused until then.') ?>
    </div>
<?php endif; ?>

<p class="text-muted">
    <?= I18N::translate('All times are UTC (webtrees server time). Current time (UTC): %s', $cron_now) ?>
</p>

<div class="mb-3">
    <a href="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobForm'])) ?>" class="btn btn-primary">
        <?= I18N::translate('New Job') ?>
    </a>
</div>

<?php if ($jobs === []): ?>
    <p><?= I18N::translate('No jobs yet. Create the first one (e.g. the linkenhancer link-index update).') ?></p>
<?php else: ?>
    <table id="wt-cronjob-jobs"
           class="table table-sm table-striped datatables d-none"
           <?= view('lists/datatables-attributes') ?>
           data-auto-width="false"
           data-sorting='[[0,"asc"]]'
           data-columns='[{},{},{},{"dataSort":6},{"dataSort":7},{"sortable":false,"searchable":false},{"visible":false},{"visible":false}]'>
        <thead>
            <tr>
                <th><?= I18N::translate('Job') ?></th>
                <th><?= I18N::translate('Schedule') ?></th>
                <th><?= I18N::translate('Next Run (UTC)') ?></th>
                <th><?= I18N::translate('Last Run') ?></th>
                <th><?= I18N::translate('Enabled') ?></th>
                <th></th>
                <th><!-- last run timestamp --></th>
                <th><!-- enabled flag --></th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($jobs as $job): ?>
            <?php
            $last    = $job->last_run;
            $enabled = (int) $job->enabled === 1;
            ?>
            <tr>
                <td>
                    <a href="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobForm', 'job' => (int) $job->id])) ?>">
                        <strong><?= e($job->title) ?></strong>
                    </a>
                    <div class="text-muted"><?= e($job->name) ?></div>
                    <?php if (isset($offered[$job->name])): ?>
                        <div>
                            <span class="badge bg-secondary"
                                  title="<?= e(I18N::translate('Seeded automatically from the %s manifest (cron-jobs.php / getCronJobs()). The "Reset" button restores the module defaults.', $offered[$job->name])) ?>">
                                <?= e(I18N::translate('from module %s', $offered[$job->name])) ?>
                            </span>
                        </div>
                    <?php endif; ?>
                </td>
                <td>
                    <?php if ((string) $job->trigger_type === 'event'): ?>
                        <span class="badge bg-info"><?= I18N::translate('event') ?></span>
                        <code><?= e((string) $job->event_name) ?></code>
                    <?php else: ?>
                        <code><?= e($job->cron) ?></code>
                        <?php
                        $human = ScheduleService::humanizeCron((string) $job->cron);
                        if ($human !== '' && $human !== (string) $job->cron):
                        ?>
                            <div class="text-muted"><?= e($human) ?></div>
                        <?php endif; ?>
                    <?php endif; ?>
                </td>
                <td><?= $job->next_run_at !== null ? e((string) $job->next_run_at) : '—' ?></td>
                <td>
                    <?php if ($last === null): ?>
                        —
                    <?php else: ?>
                        <?php
                        $badge = match ((string) $last->status) {
                            'ok'      => 'success',
                            'error'   => 'danger',
                            'timeout' => 'warning',
                            default   => 'secondary',
                        };
                        ?>
                        <span class="badge bg-<?= $badge ?>"><?= e((string) $last->status) ?></span>
                        <div class="text-muted">
                            <?= e((string) $last->started_at) ?>
                            · <?= (int) $last->duration_ms ?> ms
                            · exit <?= (int) $last->exit_code ?>
                        </div>
                        <a href="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobHistory', 'job' => (int) $job->id])) ?>">
                            <?= I18N::translate('History') ?>
                        </a>
                    <?php endif; ?>
                </td>
                <td>
                    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobToggle'])) ?>" class="d-inline">
                        <?= csrf_field() ?>
                        <input type="hidden" name="job_id" value="<?= (int) $job->id ?>">
                        <button type="submit" class="btn btn-sm <?= $enabled ? 'btn-success' : 'btn-warning' ?>" title="<?= $enabled ? I18N::translate('on') : I18N::translate('off') ?>">
                            <strong><?= $enabled ? "✓" : "✗" ?></strong>
                        </button>
                    </form>
                </td>
                <td class="text-end">
                    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobRunNow'])) ?>" class="d-inline">
                        <?= csrf_field() ?>
                        <input type="hidden" name="job_id" value="<?= (int) $job->id ?>">
                        <button type="submit" class="btn btn-sm btn-info" title="<?= e(I18N::translate('Run at the next tick (within 60 seconds)')) ?>">
                            <?= I18N::translate('Run now') ?>
                        </button>
                    </form>
                    <a href="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobForm', 'duplicate' => (int) $job->id])) ?>"
                       class="btn btn-sm btn-secondary"
                       title="<?= e(I18N::translate('Open the form prefilled with a copy of this job (new -copy slug, starts disabled)')) ?>">
                        <?= I18N::translate('Duplicate') ?>
                    </a>
                    <?php if (isset($offered[$job->name])): ?>
                        <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobReset'])) ?>" class="d-inline"
                              onsubmit="return confirm('<?= e(I18N::translate('Reset this job to the module defaults? Your changes (title, schedule, command, arguments, enabled state) will be lost; the notification setting is kept.')) ?>');">
                            <?= csrf_field() ?>
                            <input type="hidden" name="job_id" value="<?= (int) $job->id ?>">
                            <button type="submit" class="btn btn-sm btn-warning"
                                    title="<?= e(I18N::translate('Restore the settings currently offered by the module manifest')) ?>">
                                <?= I18N::translate('Reset') ?>
                            </button>
                        </form>
                    <?php endif; ?>
                    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobDelete'])) ?>" class="d-inline"
                          onsubmit="return confirm('<?= e(I18N::translate('Delete this job and its run history?')) ?>');">
                        <?= csrf_field() ?>
                        <input type="hidden" name="job_id" value="<?= (int) $job->id ?>">
                        <button type="submit" class="btn btn-sm btn-danger">
                            <?= /*I18N: webtrees.pot */ I18N::translate('Delete') ?>
                        </button>
                    </form>
                </td>
                <td><?= $last !== null ? e((string) $last->started_at) : '' ?></td>
                <td><?= (int) $job->enabled ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
<?php endif; ?>

<?php
$watch_enabled = (bool) ($watch['enabled'] ?? false);
$watch_running = (bool) ($watch['running'] ?? false);
$watch_last    = (int) ($watch['last_tick'] ?? 0);
?>
<fieldset class="border rounded p-3 mt-4">
    <legend><?= I18N::translate('Watch daemon (no OS cron needed)') ?></legend>
    <p class="text-muted">
        <?= I18N::translate('Runs the tick from a resident process instead of an OS cron / systemd timer - for hosts without cron. A watchdog restarts it automatically if it dies. Use this OR the OS trigger below, not both.') ?>
    </p>
    <p>
        <?php if ($watch_running): ?>
            <span class="badge bg-success"><?= I18N::translate('running') ?></span>
        <?php else: ?>
            <span class="badge bg-secondary"><?= I18N::translate('stopped') ?></span>
        <?php endif; ?>
        <?php if ($watch_last > 0): ?>
            <span class="text-muted"><?= I18N::translate('Last activity (UTC): %s', date('Y-m-d H:i:s', $watch_last)) ?></span>
        <?php endif; ?>
    </p>
    <?php if ($watch_enabled): ?>
        <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminWatchStop'])) ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-sm btn-warning"><?= I18N::translate('Stop watch') ?></button>
        </form>
    <?php else: ?>
        <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminWatchStart'])) ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-sm btn-primary"><?= I18N::translate('Start watch') ?></button>
        </form>
    <?php endif; ?>
</fieldset>

<fieldset class="border rounded p-3 mt-4">
    <legend><?= I18N::translate('Trigger Installation') ?></legend>
    <p class="text-muted">
        <?= I18N::translate('The module itself does not start. One OS timer (classic cron or systemd) must call the tick once per minute. Pick one of the two options below - the paths are already filled in for this installation.') ?>
    </p>

    <details>
        <summary><?= /*I18N: webtrees.pot */ I18N::translate('Details'); ?></summary>
        <div class="bg-light p-2 rounded mt-2 mb-0">
            <h6><?= I18N::translate('Option A: classic cron (every minute)') ?>
            </h6>
            <pre class="bg-light p-2 rounded"><?= e($install['cron_line']) ?></pre>
            
            <h6>
                <?= I18N::translate('Option B: systemd timer') ?>
            </h6>
            <h7>wt-cronjob-tick.service</h7>
            <pre class="bg-light p-2 rounded"><?= e($install['service_unit']) ?></pre>
            <h7>wt-cronjob-tick.timer</h7>
            <pre class="bg-light p-2 rounded"><?= e($install['timer_unit']) ?></pre>
            <h7><?= I18N::translate('Install commands') ?></h7>
            <pre class="bg-light p-2 rounded"><?= e($install['install_commands']) ?></pre>
        </div>
    </details>
</fieldset>

<fieldset class="border rounded p-3 mt-4">
    <legend><?= I18N::translate('Event webhook (external trigger)') ?></legend>
    <p class="text-muted">
        <?= I18N::translate('External systems can queue an event by GETting the endpoint below. Each queued event runs its matching event-triggered job(s) at the next tick. The token is required (send it in the X-Cronjob-Token header, not in the URL) and the endpoint is rate-limited.') ?>
    </p>
    <div class="mb-2">
        <label class="form-label" for="cj_webhook_url"><?= I18N::translate('Endpoint') ?></label>
        <input type="text" class="form-control" id="cj_webhook_url" readonly
               value="<?= e(route('module', ['module' => $module->name(), 'action' => 'Event'])) ?>">
        <div class="form-text"><?= I18N::translate('GET with query params event=<name> and data=<json> (optional); send the token in the X-Cronjob-Token header (or, less secure, as ?token=…).') ?></div>
    </div>
    <div class="mb-2">
        <label class="form-label" for="cj_event_token"><?= I18N::translate('Token') ?></label>
        <input type="text" class="form-control font-monospace" id="cj_event_token" readonly value="<?= e($event_token) ?>">
    </div>
    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminEventToken'])) ?>" class="d-inline">
        <?= csrf_field() ?>
        <button type="submit" class="btn btn-sm btn-secondary"><?= I18N::translate('Regenerate token') ?></button>
    </form>
</fieldset>

<fieldset class="border rounded p-3 mt-4">
    <legend><?= I18N::translate('Pseudo-Events (state polling)') ?></legend>
    <p class="text-muted">
        <?= I18N::translate('webtrees has no event bus, so core actions are observed by polling. The module checks the states below at most every 5 minutes and queues an event when something changes; an event-triggered job then acts on it. The first run only records a baseline and does not fire.') ?>
    </p>
    <ul class="mb-2">
        <?php foreach ($detectors as $detector): ?>
            <li>
                <code><?= e($detector->eventName()) ?></code>
                <span class="text-muted"><?= e(I18N::translate($detector->label())) ?></span>
            </li>
        <?php endforeach; ?>
    </ul>
    <p class="text-muted">
        <?= I18N::translate('To activate, enable the "cronjob:pseudo-events" job in the table above. It runs in the tick child process - isolated from any web request and bounded by its timeout.') ?>
    </p>
</fieldset>