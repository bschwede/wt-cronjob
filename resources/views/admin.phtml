                        <td><?php if ($entry['payload'] !== []): ?><code><?= e(implode(', ', $entry['payload'])) ?></code><?php else: ?>—<?php endif; ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </fieldset>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header" id="acc-command-head">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#acc-command" aria-expanded="false" aria-controls="acc-command">
        <strong><?= MoreI18N::xlate('Commands') ?>
            </strong>
        </button>
    </h2>
    <div id="acc-command" class="accordion-collapse collapse" aria-labelledby="acc-command-head">
        <div class="accordion-body px-4">

        <fieldset class="border rounded p-3 mt-2 mb-2">
            <legend><?= I18N::translate('Command catalog') ?></legend>
            <p class="text-muted">
                <?= I18N::translate('Every command a job may run: the allowlisted core commands, commands announced by modules (with their available parameters) and module CLI scripts. A module that announces commands curates its own list, so its internal scripts (e.g. cronjob tick/watch/wrap) are not offered. Use these in the “Command” field of a job.') ?>
            </p>
            <table id="wt-cronjob-commands"
                   class="table table-sm table-striped datatables d-none"
                   <?= view('lists/datatables-attributes') ?>
                   data-sorting='[[0,"asc"]]'
                   data-columns='[{},{},{},{},{}]'>
                <thead>
                    <tr>
                        <th><?= I18N::translate('Command') ?></th>
                        <th><?= MoreI18N::xlate('Type') ?></th>
                        <th><?= MoreI18N::xlate('Source') ?></th>
                        <th><?= MoreI18N::xlate('Description') ?></th>
                        <th><?= I18N::translate('Parameters') ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($command_catalog as $command => $entry): ?>
                    <tr>
                        <td><code><?= e((string) $command) ?></code></td>
                        <td><?= e((string) $entry['command_type']) ?></td>
                        <td><?= e((string) $entry['source']) ?></td>
                        <td><?= e(I18N::translate((string) $entry['description'])) ?></td>
                        <td>
                            <?php if ($entry['params'] === []): ?>
                                —
                            <?php else: ?>
                                <ul class="list-unstyled mb-0">
                                    <?php foreach ($entry['params'] as $param): ?>
                                        <li>
                                            <code><?= e((string) $param['name']) ?></code><?= !empty($param['default']) ? '=' . e((string) $param['default']) : '' ?>
                                            <?php if (empty($param['optional'])): ?> <span class="badge bg-warning"><?= I18N::translate('required') ?></span><?php endif; ?>
                                            <?php if (!empty($param['description'])): ?> <span class="text-muted"><?= e(I18N::translate((string) $param['description'])) ?></span><?php endif; ?>
                                        </li>
                                    <?php endforeach; ?>
                                </ul>
                            <?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </fieldset>
      </div>
    </div>
  </div>

</div>

<script>
    (function () {
        <?php 
        // The event/command catalogs are DataTables inside a collapsed
        // accordion: re-measure them once their panel is shown so the column
        // widths and the paging/search controls render correctly.
        ?>
        var accordion = document.getElementById('accordion');

        if (accordion) {
            accordion.addEventListener('shown.bs.collapse', function () {
                document.querySelectorAll('#wt-cronjob-events, #wt-cronjob-commands').forEach(function (el) {
                    var instance = el.DataTable;
                    if (instance) {
                        instance.columns.adjust();
                    }
                });
            });
        }
    })();
</script>