<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Schwendinger\Webtrees\Module\Cronjob\Services\JobRunner;

/**
 * @var string $title
 * @var \Schwendinger\Webtrees\Module\Cronjob\CronjobModule $module
 * @var object|null $job
 * @var array<string, array{command_type: string, source: string, description: string, params: list<array<string, mixed>>}> $command_catalog
 * @var string $cron_now
 * @var list<string> $triggers_time
 * @var list<string> $triggers_event
 * @var array<int, array<int, string>|null> $cron_previews
 * @var bool $notify
 * @var string|null $copy_of
 * @var array<string, mixed>|null $form_values
 * @var array<string, array{source: string, description: string, payload: list<string>}> $event_catalog
 */

$copy_of  = $copy_of ?? null;
$fv       = $form_values ?? [];
$back_url = route('module', ['module' => $module->name(), 'action' => 'Admin']);
$is_edit  = $job !== null;
$job_id      = $is_edit ? (int) $job->id : 0;
$event_catalog = $event_catalog ?? [];
$command_catalog = $command_catalog ?? [];

// Announced commands that carry available parameters, keyed by command value
// (drives the dynamic hint under the command field).
$command_params = [];
foreach ($command_catalog as $command => $entry) {
    if (($entry['params'] ?? []) !== []) {
        $command_params[(string) $command] = $entry['params'];
    }
}

// A module-offered job keeps its <module>:<name> key; the name field is then
// read-only and its pattern also accepts the module prefix.
$is_offered   = $is_edit && str_contains((string) $job->name, ':');
$name_pattern = $is_offered
    ? '[a-z0-9][a-z0-9_\-]{0,63}(:[a-z0-9][a-z0-9_\-]{0,63})?'
    : '[a-z0-9][a-z0-9_\-]{0,63}';

// On a failed save the form is re-rendered with the submitted values.
// (The trigger rows travel in $triggers_time/$triggers_event - the action
// already merged the stash into them.)
$name_v    = $fv['name'] ?? ($is_edit ? (string) $job->name : '');
$title_v   = $fv['title'] ?? ($is_edit ? (string) $job->title : '');
$command_v = $fv['command'] ?? ($is_edit ? (string) $job->command : '');
$args_v    = $fv['args'] ?? ($is_edit ? (string) $job->args : '');
$timeout_v = $fv['timeout'] ?? ($is_edit ? (int) $job->timeout_sec : $module::TIMEOUT_STD);
$enabled_v = $fv['enabled'] ?? ($is_edit ? ((int) $job->enabled === 1) : true);

$crumbs = [
    route(ControlPanel::class) => /*I18N: webtrees.pot */ I18N::translate('Control panel'),
    $back_url => $module->title(),
];
// The breadcrumb component renders labels unescaped, and I18N::translate()
// does not escape its arguments - so admin-editable values (job titles) must
// be escaped exactly once, here, at the source (§16, F3).
$header = "";
if ($copy_of !== null) {
    $header = I18N::translate('New Job (copy of %s)', e($copy_of));
    $crumbs[0] = $header;
} elseif ($is_edit) {
    $crumbs[route('module', ['module' => $module->name(), 'action' => 'AdminJobForm', 'job' => (int) $job->id])] = e($job->title);
    $header = I18N::translate('Edit Job');
    $crumbs[0] = $header;
} else {
    $header = I18N::translate('New Job');
    $crumbs[0] = $header;
}

?>
<?= view('components/breadcrumbs', ['links' => $crumbs]) ?>

<h1><?= $header ?></h1>

<form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobSave'])) ?>" class="needs-validation" novalidate>
    <?= csrf_field() ?>
    <input type="hidden" name="job_id" value="<?= $job_id ?>">
    <input type="hidden" name="copy_of" value="<?= e($copy_of ?? '') ?>">

    <fieldset class="border rounded p-3 mb-3">
        <legend><?= /*I18N: webtrees.pot */ I18N::translate('General') ?></legend>

        <div class="mb-3">
            <label for="cj_name" class="form-label"><?= I18N::translate('Name (slug)') ?></label>
            <input type="text" class="form-control" id="cj_name" name="name" required
                   pattern="<?= e($name_pattern) ?>"
                   <?= $is_offered ? 'readonly' : '' ?>
                   value="<?= e($name_v) ?>"
                   placeholder="linkenhancer-index">
            <?php if ($is_offered): ?>
                <div class="form-text"><?= I18N::translate('This job is offered by a module, so its name is fixed.') ?></div>
            <?php else: ?>
                <div class="form-text"><code>a-z, 0-9, "_", "-"</code> <?= I18N::translate('Used as identifier, not shown to users.') ?></div>
            <?php endif; ?>
        </div>

        <div class="mb-3">
            <label for="cj_title" class="form-label"><?= /*I18N: webtrees.pot */ I18N::translate('Title') ?></label>
            <input type="text" class="form-control" id="cj_title" name="title" required
                   maxlength="128"
                   value="<?= e($title_v) ?>"
                   placeholder="<?= I18N::translate('Update link index') ?>">
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="cj_enabled" name="enabled" value="1"
                   <?= $enabled_v ? 'checked' : '' ?>>
            <label class="form-check-label" for="cj_enabled"><?= I18N::translate('Enabled') ?></label>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="cj_notify" name="notify" value="1"
                   <?= $notify ? 'checked' : '' ?>>
            <label class="form-check-label" for="cj_notify"><?= I18N::translate('Notify administrators on failure') ?></label>
            <div class="form-text"><?= I18N::translate('On failure, message the site’s administrator accounts (e-mail and/or internal message, per each admin’s own contact preference).') ?></div>
        </div>
    </fieldset>

    <fieldset class="border rounded p-3 mb-3">
        <legend><?= I18N::translate('Triggers') ?></legend>
        <div class="form-text">
            <?= I18N::translate('The job runs when any of its triggers fires: on one or more cron schedules (UTC) and/or on one or more named events. At least one trigger is required.') ?>
        </div>

        <div class="mb-3">
            <label class="form-label"><?= I18N::translate('Time triggers (cron schedule)') ?></label>
            <div id="cj_time_rows">
                <?php foreach ($triggers_time as $i => $cron_value): ?>
                    <div class="input-group input-group-sm mb-1">
                        <input type="text" class="form-control" name="triggers_time[]"
                               placeholder="*/30 * * * *"
                               value="<?= e($cron_value) ?>">
                        <button type="button" class="btn btn-outline-secondary cj_remove_time" title="<?= e(I18N::translate('Remove')) ?>">&times;</button>
                    </div>
                    <?php if (isset($cron_previews[$i])): ?>
                        <?php if ($cron_previews[$i] !== null): ?>
                            <div class="text-muted mb-1 ms-2">
                                <?= I18N::translate('Next runs (UTC):') ?>
                                <?php foreach ($cron_previews[$i] as $run): ?>
                                    <code><?= e($run) ?></code>
                                <?php endforeach; ?>
                            </div>
                        <?php else: ?>
                            <div class="text-danger mb-1 ms-2"><?= I18N::translate('Invalid cron expression (5 fields, UTC).') ?></div>
                        <?php endif; ?>
                    <?php endif; ?>
                <?php endforeach; ?>
            </div>
            <div class="form-text"><?= I18N::translate('All times are UTC (webtrees server time). Current time (UTC): %s', $cron_now) ?></div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-1" id="cj_add_time"><?= I18N::translate('+ Add cron trigger') ?></button>
            <template id="cj_time_row_template">
                <div class="input-group input-group-sm mb-1">
                    <input type="text" class="form-control" name="triggers_time[]" placeholder="*/30 * * * *">
                    <button type="button" class="btn btn-outline-secondary cj_remove_time" title="<?= e(I18N::translate('Remove')) ?>">&times;</button>
                </div>
            </template>
        </div>

        <div class="mb-3">
            <label class="form-label"><?= I18N::translate('Event triggers') ?></label>
            <div id="cj_event_rows">
                <?php foreach ($triggers_event as $event_value): ?>
                    <div class="input-group input-group-sm mb-1">
                        <input type="text" class="form-control" name="triggers_event[]"
                               pattern="[a-z0-9][a-z0-9_\-]{0,63}(?::[a-z0-9_][a-z0-9_\-]{0,63})?"
                               maxlength="64"
                               list="cj_event_names"
                               placeholder="cronjob:gedcom-changed"
                               value="<?= e($event_value) ?>">
                        <button type="button" class="btn btn-outline-secondary cj_remove_event" title="<?= e(I18N::translate('Remove')) ?>">&times;</button>
                    </div>
                <?php endforeach; ?>
            </div>
            <datalist id="cj_event_names">
                <?php foreach ($event_catalog as $name => $entry): ?>
                    <option value="<?= e((string) $name) ?>"><?= e($entry['description'] !== '' ? I18N::translate((string) $entry['description']) : ((string) $name . ' (' . $entry['source'] . ')')) ?></option>
                <?php endforeach; ?>
            </datalist>
            <div class="form-text"><?= I18N::translate('The job runs once for each queued event with one of these names (webhook, module push, built-in pseudo-event poller, or a route trigger).') ?></div>
            <div class="form-text"><?= I18N::translate('Suggested: module-announced events, built-in pseudo-events (cronjob:…) and route events (_route:…). Plain slugs for your own events work too. The full list is in the event catalog on the admin page.') ?></div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-1" id="cj_add_event"><?= I18N::translate('+ Add event trigger') ?></button>
            <template id="cj_event_row_template">
                <div class="input-group input-group-sm mb-1">
                    <input type="text" class="form-control" name="triggers_event[]"
                           pattern="[a-z0-9][a-z0-9_\-]{0,63}(?::[a-z0-9_][a-z0-9_\-]{0,63})?"
                           maxlength="64"
                           list="cj_event_names"
                           placeholder="cronjob:gedcom-changed">
                    <button type="button" class="btn btn-outline-secondary cj_remove_event" title="<?= e(I18N::translate('Remove')) ?>">&times;</button>
                </div>
            </template>
        </div>
    </fieldset>

    <fieldset class="border rounded p-3 mb-3">
        <legend><?= I18N::translate('Command') ?></legend>

        <div class="mb-3">
            <label for="cj_command" class="form-label"><?= I18N::translate('Command') ?></label>
            <input type="text" class="form-control" id="cj_command" name="command" required list="cj_commands"
                   placeholder="modules_v4/linkenhancer/cli/build-link-index.php"
                   value="<?= e($command_v) ?>">
            <datalist id="cj_commands">
                <?php foreach ($command_catalog as $command => $entry): ?>
                    <option value="<?= e((string) $command) ?>"><?= e($entry['description'] !== '' ? I18N::translate((string) $entry['description']) : (string) $entry['source']) ?></option>
                <?php endforeach; ?>
            </datalist>
            <div class="form-text"><?= I18N::translate('A %1s path or an allowlisted core command (%2$s).', '<code>modules_v4/&lt;module&gt;/cli/&lt;script&gt;.php</code>', '<code>' . implode(', ', JobRunner::ALLOWED_CORE_COMMANDS) . '</code>') ?></div>
            <div id="cj_command_params_hint" class="form-text" hidden></div>
        </div>

        <div class="mb-3">
            <label for="cj_args" class="form-label"><?= I18N::translate('Arguments (optional)') ?></label>
            <input type="text" class="form-control" id="cj_args" name="args"
                   placeholder="--limit=5000"
                   value="<?= e($args_v) ?>">
            <div class="form-text"><?= I18N::translate('Plain options/values only, no shell metacharacters, max %1$s tokens.', '10') ?></div>
        </div>

        <div class="mb-3">
            <label for="cj_timeout" class="form-label"><?= I18N::translate('Timeout (seconds, %1$s - %2$s)', (string) $module::TIMEOUT_MIN, (string) $module::TIMEOUT_MAX) ?></label>
            <input type="number" class="form-control" id="cj_timeout" name="timeout" min="<?= $module::TIMEOUT_MIN ?>" max="<?= $module::TIMEOUT_MAX ?>" step="5"
                   value="<?= (int) $timeout_v ?>">
        </div>

        <div class="alert alert-warning mb-0">
            <?= I18N::translate('Note on sensitive output: %1$s writes the complete tree as %2$s into data/ (full personal data!), %3$s lists all user e-mail addresses, %4$s lists all site settings. This output is stored in the run history (admin-only).', '<code>tree-export</code>', '<code>&lt;tree&gt;.ged</code>', '<code>user-list</code>', '<code>site-setting --list</code>') ?>
        </div>
