<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Schwendinger\Webtrees\Module\Cronjob\Services\JobRunner;

/**
 * @var string $title
 * @var \Schwendinger\Webtrees\Module\Cronjob\CronjobModule $module
 * @var object|null $job
 * @var array<int, string> $candidates
 * @var array<int, string>|null $preview
 * @var string $cron_now
 * @var string $trigger_type
 * @var string $event_name
 * @var bool $notify
 * @var string|null $copy_of
 */

$copy_of  = $copy_of ?? null;
$back_url = route('module', ['module' => $module->name(), 'action' => 'Admin']);
$is_edit  = $job !== null;
$job_id   = $is_edit ? (int) $job->id : 0;

$crumbs = [
    route(ControlPanel::class) => /*I18N: webtrees.pot */ I18N::translate('Control panel'),
    $back_url => $module->title(),
];
if ($copy_of !== null) {
    $crumbs[0] = I18N::translate('New Job (copy of %s)', $copy_of);
} elseif ($is_edit) {
    $crumbs[route('module', ['module' => $module->name(), 'action' => 'AdminJobForm', 'job' => (int) $job->id])] = $job->title;
    $crumbs[0] = I18N::translate('Edit Job');
} else {
    $crumbs[0] = I18N::translate('New Job');
}

?>
<?= view('components/breadcrumbs', ['links' => $crumbs]) ?>

<h1><?= $copy_of !== null ? I18N::translate('New Job (copy of %s)', $copy_of) : ($is_edit ? I18N::translate('Edit Job') : I18N::translate('New Job')) ?></h1>

<form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminJobSave'])) ?>" class="needs-validation" novalidate>
    <?= csrf_field() ?>
    <input type="hidden" name="job_id" value="<?= $job_id ?>">

    <fieldset class="border rounded p-3 mb-3">
        <legend><?= /*I18N: webtrees.pot */ I18N::translate('General') ?></legend>

        <div class="mb-3">
            <label for="cj_name" class="form-label"><?= I18N::translate('Name (slug)') ?></label>
            <input type="text" class="form-control" id="cj_name" name="name" required
                   pattern="[a-z0-9][a-z0-9_\-]{0,63}"
                   value="<?= $is_edit ? e($job->name) : '' ?>"
                   placeholder="linkenhancer-index">
            <div class="form-text"><code>a-z, 0-9, "_", "-"</code> <?= I18N::translate('Used as identifier, not shown to users.') ?></div>
        </div>

        <div class="mb-3">
            <label for="cj_title" class="form-label"><?= /*I18N: webtrees.pot */ I18N::translate('Title') ?></label>
            <input type="text" class="form-control" id="cj_title" name="title" required
                   maxlength="128"
                   value="<?= $is_edit ? e($job->title) : '' ?>"
                   placeholder="<?= I18N::translate('Update link index') ?>">
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="cj_enabled" name="enabled" value="1"
                   <?= $is_edit ? ((int) $job->enabled === 1 ? 'checked' : '') : 'checked' ?>>
            <label class="form-check-label" for="cj_enabled"><?= I18N::translate('Enabled') ?></label>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="cj_notify" name="notify" value="1"
                   <?= $notify ? 'checked' : '' ?>>
            <label class="form-check-label" for="cj_notify"><?= I18N::translate('Notify administrators on failure') ?></label>
            <div class="form-text"><?= I18N::translate('On failure, message the site’s administrator accounts (e-mail and/or internal message, per each admin’s own contact preference).') ?></div>
        </div>
    </fieldset>

    <fieldset class="border rounded p-3 mb-3">
        <legend><?= I18N::translate('Trigger / Schedule') ?></legend>

        <div class="mb-3">
            <label for="cj_trigger_type" class="form-label"><?= I18N::translate('Trigger') ?></label>
            <select class="form-select" id="cj_trigger_type" name="trigger_type">
                <option value="time" <?= $trigger_type === 'time' ? 'selected' : '' ?>><?= I18N::translate('Time-based (cron schedule)') ?></option>
                <option value="event" <?= $trigger_type === 'event' ? 'selected' : '' ?>><?= I18N::translate('Event (webhook or module push)') ?></option>
            </select>
        </div>

        <div id="cj_time_fields" <?= $trigger_type === 'event' ? 'hidden' : '' ?>>
            <div class="mb-3">
                <label for="cj_cron" class="form-label"><?= I18N::translate('Cron expression (5 fields, UTC)') ?></label>
                <input type="text" class="form-control" id="cj_cron" name="cron"
                       placeholder="*/30 * * * *"
                       value="<?= $is_edit ? e($job->cron) : '' ?>">
                <div class="form-text"><?= I18N::translate('All times are UTC (webtrees server time). Current time (UTC): %s', $cron_now) ?></div>
            </div>

            <?php if ($preview !== null): ?>
                <div class="mb-3">
                    <span class="text-muted"><?= I18N::translate('Next runs (UTC):') ?></span>
                    <ul class="mb-0">
                        <?php foreach ($preview as $run): ?>
                            <li><code><?= e($run) ?></code></li>
                        <?php endforeach; ?>
                    </ul>
                </div>
            <?php endif; ?>
        </div>

        <div id="cj_event_fields" <?= $trigger_type === 'time' ? 'hidden' : '' ?>>
            <div class="mb-3">
                <label for="cj_event_name" class="form-label"><?= I18N::translate('Event name') ?></label>
                <input type="text" class="form-control" id="cj_event_name" name="event_name"
                       pattern="[a-z0-9][a-z0-9_\-]{0,63}"
                       placeholder="index-dirty"
                       value="<?= e($event_name) ?>">
                <div class="form-text"><?= I18N::translate('The job runs once for each queued event with this name (from the webhook or a module call).') ?></div>
            </div>
        </div>
    </fieldset>

    <fieldset class="border rounded p-3 mb-3">
        <legend><?= I18N::translate('Command') ?></legend>

        <div class="mb-3">
            <label for="cj_command" class="form-label"><?= I18N::translate('Command') ?></label>
            <input type="text" class="form-control" id="cj_command" name="command" required list="cj_commands"
                   placeholder="modules_v4/linkenhancer/cli/build-link-index.php"
                   value="<?= $is_edit ? e($job->command) : '' ?>">
            <datalist id="cj_commands">
                <?php foreach ($candidates as $candidate): ?>
                    <option value="<?= e($candidate) ?>"></option>
                <?php endforeach; ?>
            </datalist>
            <div class="form-text"><?= I18N::translate('A %1s path or an allowlisted core command (%2$s).', '<code>modules_v4/&lt;module&gt;/cli/&lt;script&gt;.php</code>', '<code>' . implode(', ', JobRunner::ALLOWED_CORE_COMMANDS) . '</code>') ?></div>
        </div>

        <div class="mb-3">
            <label for="cj_args" class="form-label"><?= I18N::translate('Arguments (optional)') ?></label>
            <input type="text" class="form-control" id="cj_args" name="args"
                   placeholder="--limit=5000"
                   value="<?= $is_edit ? e($job->args) : '' ?>">
            <div class="form-text"><?= I18N::translate('Plain options/values only, no shell metacharacters, max %1$s tokens.', '10') ?></div>
        </div>

        <div class="mb-3">
            <label for="cj_timeout" class="form-label"><?= I18N::translate('Timeout (seconds, %1$s - %2$s)', (string) $module::TIMEOUT_MIN, (string) $module::TIMEOUT_MAX) ?></label>
            <input type="number" class="form-control" id="cj_timeout" name="timeout" min="<?= $module::TIMEOUT_MIN ?>" max="<?= $module::TIMEOUT_MAX ?>" step="5"
                   value="<?= $is_edit ? (int) $job->timeout_sec : $module::TIMEOUT_STD ?>">
        </div>

        <div class="alert alert-warning mb-0">
            <?= I18N::translate('Note on sensitive output: %1$s writes the complete tree as %2$s into data/ (full personal data!), %3$s lists all user e-mail addresses, %4$s lists all site settings. This output is stored in the run history (admin-only).', '<code>tree-export</code>', '<code>&lt;tree&gt;.ged</code>', '<code>user-list</code>', '<code>site-setting --list</code>') ?>
        </div>
    </fieldset>

    <div class="btn-group mb-3">
        <button type="submit" class="btn btn-primary"><?= I18N::translate('Save Job') ?></button>
        <a href="<?= e($back_url) ?>" class="btn btn-secondary"><?= /*I18N: webtrees.pot */ I18N::translate('Cancel') ?></a>
    </div>
</form>

<script>
    (function () {
        var sel = document.getElementById('cj_trigger_type');
        var timeFields = document.getElementById('cj_time_fields');
        var eventFields = document.getElementById('cj_event_fields');
        var cron = document.getElementById('cj_cron');
        var eventName = document.getElementById('cj_event_name');
        function toggle() {
            var isEvent = sel.value === 'event';
            timeFields.hidden = isEvent;
            eventFields.hidden = !isEvent;
            cron.required = !isEvent;
            eventName.required = isEvent;
        }
        sel.addEventListener('change', toggle);
        toggle();
    })();
</script>
