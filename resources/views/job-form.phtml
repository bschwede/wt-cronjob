    <div class="btn-group mb-3">
        <button type="submit" class="btn btn-primary"><?= I18N::translate('Save Job') ?></button>
        <a href="<?= e($back_url) ?>" class="btn btn-secondary"><?= /*I18N: webtrees.pot */ I18N::translate('Cancel') ?></a>
    </div>
</form>

<script>
    (function () {
        // Multi-trigger rows (§13): add/remove cron and event trigger rows.
        function wireRows(containerId, buttonId, templateId, removeClass) {
            var container = document.getElementById(containerId);
            var button = document.getElementById(buttonId);
            var template = document.getElementById(templateId);
            if (!container || !button || !template) {
                return;
            }
            button.addEventListener('click', function () {
                var clone = template.content.cloneNode(true);
                var input = clone.querySelector('input');
                if (input) {
                    input.value = '';
                }
                container.appendChild(clone);
            });
            container.addEventListener('click', function (e) {
                var target = e.target;
                if (target && target.classList && target.classList.contains(removeClass)) {
                    var row = target.closest('.input-group');
                    if (row && row.parentElement === container) {
                        row.remove();
                    }
                }
            });
        }
        wireRows('cj_time_rows', 'cj_add_time', 'cj_time_row_template', 'cj_remove_time');
        wireRows('cj_event_rows', 'cj_add_event', 'cj_event_row_template', 'cj_remove_event');

        // Dynamic hint: when the entered command matches an announced command,
        // list its available parameters under the field.
        var commandInput = document.getElementById('cj_command');
        var paramsHint = document.getElementById('cj_command_params_hint');
        var commandParams = <?= json_encode($command_params, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>;
        var paramsLabel = <?= json_encode(I18N::translate('Available parameters'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>;
        var requiredLabel = <?= json_encode(I18N::translate('required'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>;
        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }
        function updateParamsHint() {
            var params = commandParams[commandInput.value.trim()];
            if (!params || params.length === 0) {
                paramsHint.hidden = true;
                paramsHint.innerHTML = '';
                return;
            }
            var lines = params.map(function (p) {
                var line = '<code>' + escapeHtml(p.name) + '</code>';
                if (p.optional === false) {
                    line += ' <span class="text-danger">(' + escapeHtml(requiredLabel) + ')</span>';
                }
                if (p.default) {
                    line += ' <span class="text-muted">[default: ' + escapeHtml(p.default) + ']</span>';
                }
                if (p.description) {
                    line += ' <span class="text-muted">' + escapeHtml(p.description) + '</span>';
                }
                return line;
            });
            paramsHint.innerHTML = '<strong>' + escapeHtml(paramsLabel) + ':</strong><br>' + lines.join('<br>');
            paramsHint.hidden = false;
        }
        commandInput.addEventListener('input', updateParamsHint);
        commandInput.addEventListener('change', updateParamsHint);
        updateParamsHint();
    })();
</script>
